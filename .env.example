# Tanzania Sharing Association — environment variables
#
# Copy to .env.local and fill in. Never commit real values.
# Set these SEPARATELY for each Vercel environment (Production / Preview /
# Development). Sharing one DATABASE_URL across environments means preview
# deploys and local `prisma db push` write to live member data.

# ─── Database (Neon) ────────────────────────────────────────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Direct (unpooled) connection. Prisma Migrate needs this; pooled connections
# cannot run DDL reliably. On Neon this is the "-pooler"-less host.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED. The app throws at boot if this is missing — there is deliberately
# no fallback, because a predictable secret makes every session JWT forgeable.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full origin of this deployment, e.g. https://tansha.org
NEXTAUTH_URL=http://localhost:3000

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
# Where form submissions and admin alerts are delivered.
# In preview/staging this MUST be a developer address, never tansha.hq@gmail.com,
# so test submissions never reach real officers.
ADMIN_EMAIL=

# ─── Public ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ════════════════════════════════════════════════════════════════════════════
# NOT YET WIRED UP — listed so environments can be provisioned ahead of time.
# The features below are not implemented yet; leaving these unset is fine.
# ════════════════════════════════════════════════════════════════════════════

# ─── Phone login (Twilio Verify) ────────────────────────────────────────────
# Two Verify Services are required: Twilio allows only one pending verification
# per (service, phone), so a login code and a consent code on the same handset
# would otherwise collide.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_VERIFY_CONSENT_SERVICE_SID=
# Leave false until the Meta WhatsApp sender is approved; SMS works meanwhile.
# TWILIO_WHATSAPP_ENABLED=false
# AUTH_PHONE_OTP_ENABLED=false

# ─── Payments (Stripe) ──────────────────────────────────────────────────────
# Preview/staging MUST use sk_test_ keys. Register the webhook endpoint and set
# the signing secret per environment — a production secret will not verify a
# test-mode event.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYMENTS_ENABLED=false

# ─── Rate limiting (Upstash Redis) ──────────────────────────────────────────
# HTTP-based, because in-memory limiting does nothing on serverless where each
# invocation has its own memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Bot protection (Cloudflare Turnstile) ──────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ─── Monitoring (Sentry) ────────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─── Scheduled jobs ─────────────────────────────────────────────────────────
# Shared secret asserted by every /api/cron/* route.
# CRON_SECRET=
# Pepper for hashing IPs in the audit log, so the log is not itself a PII store.
# AUDIT_IP_PEPPER=

# ─── Leaders' test environment ──────────────────────────────────────────────
# Enables demo sign-in buttons and the "reset demo data" action.
# The app refuses to boot if this is true in production.
# DEMO_MODE=false
