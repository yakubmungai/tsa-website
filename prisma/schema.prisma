datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  // Nullable: the member roster has no email column at all, so members who sign
  // in by phone may never supply one.
  email        String?   @unique
  passwordHash String?   // Null for accounts that sign in by phone code only
  role         Role      @default(MEMBER) // MEMBER, ADMIN

  // NOT unique. Spouses share a handset — six pairs do in the real roster — so a
  // phone number identifies a set of candidate accounts, not one identity.
  // The uniqueness that matters is already on memberId.
  phoneE164       String?
  phoneVerifiedAt DateTime?

  /// Bumped to invalidate every existing session for this user: password
  /// change, phone change, role change, admin force-logout. Compared against
  /// the value carried in the JWT on each request.
  sessionVersion Int      @default(0)
  claimedAt      DateTime?  // when the account was first activated
  lastLoginAt    DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Link to the member profile details
  memberId     String?   @unique
  member       Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  delegationsHeld Delegation[]    @relation("DelegationDelegate")
  actingSessions  ActingSession[] @relation("ActingActor")

  @@index([phoneE164])
}

enum Role {
  MEMBER
  ADMIN
}

// Verification tokens for OTP code verification during signup
model VerificationToken {
  id        String   @id @default(uuid())
  target    String   // Email address
  token     String   // 6-digit OTP code
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([target, token])
}

// Member profile details
model Member {
  id              String             @id @default(uuid())
  names           String             // Full name
  phone           String?            // As recorded by the treasurer, preserved verbatim
  /// Normalised to E.164, and the identity members sign in with.
  /// NOT unique: spouses share a handset. See User.phoneE164.
  phoneE164       String?
  archivedAt      DateTime?          // Soft delete. Financial history must survive.

  /// Collected by the application form and previously discarded on submit.
  email             String?      @unique
  dateOfBirth       DateTime?
  placeOfBirth      String?
  /// Human-facing number the treasurer's paper records use.
  memberNumber      Int?         @unique
  /// Admission date. Required by the constitution's six-month rule for new
  /// members (Art 4.5), so it is recorded now even though nothing reads it yet.
  joinedAt          DateTime?
  joinedAtEstimated Boolean      @default(true)
  status            MemberStatus @default(ACTIVE)
  preferredLanguage String       @default("sw")
  address         String?            // Full address
  husbandWife     String?            // Spouse name
  spousePhone     String?
  parents         String[]           // List of parents
  children        String[]           // List of children
  siblings        String[]           // List of siblings
  witnesses       Json[]             // Array of { name, phone }
  nextOfKin       Json[]             // Array of { name, phone }
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User?
  transactions    Transaction[]
  submissions     FormSubmission[]
  delegationsGranted Delegation[] @relation("DelegationOwner")
  ledgerEntries      LedgerEntry[]
  balance            MemberBalance?

  @@index([archivedAt])
  @@index([phoneE164])
}

/// A single-use ticket minted after a phone code has been verified.
///
/// This is what closes the account-takeover hole. The old flow let the client
/// name the member at the final step, so anyone who knew a member's phone could
/// send a code to their own email and claim that member's ledger.
///
/// Now the server resolves which accounts a *verified* phone number may unlock
/// and records them in `candidates`. The client can only choose from that list,
/// which matters because a handset shared by spouses legitimately maps to two
/// accounts.
///
/// The ticket also exists because Twilio Verify consumes a verification on the
/// first successful check — so the account chooser cannot re-verify, and must
/// rely on something the server already vouched for.
model AuthTicket {
  id         String   @id @default(uuid())
  /// SHA-256 of the value handed to the client. The raw ticket is never stored.
  tokenHash  String   @unique
  purpose    String   // "PHONE_LOGIN"
  phoneE164  String
  /// [{ kind: "user" | "claim", id, displayName }]
  candidates Json
  ipHash     String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

/// One row per code we were asked to send. Feeds abuse investigation and gives
/// the delivery channel an audit trail; the code itself is never stored here.
model OtpRequest {
  id        String   @id @default(uuid())
  phoneE164 String
  channel   String   // "sms" | "whatsapp" | "call" | "demo"
  purpose   String   // "LOGIN"
  outcome   String   // SENT | RATE_LIMITED | NO_ACCOUNT | TRANSPORT_ERROR
  providerRef String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([phoneE164, createdAt])
  @@index([createdAt])
}

/// Fixed-window rate limit counters.
///
/// Kept in Postgres rather than in memory: on serverless every invocation has
/// its own memory, so an in-process counter limits nothing.
model RateLimitBucket {
  id          String   @id @default(uuid())
  scope       String   // "otp:send:phone", "otp:check:phone", "otp:send:ip", ...
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([scope, key, windowStart])
  @@index([windowStart])
}

// Transaction history for auditing balances
model Transaction {
  id          String   @id @default(uuid())
  memberId    String
  // Restrict, not Cascade: deleting a member must never silently erase their
  // financial history. Members are archived instead (Member.archivedAt), and
  // the KATIBA (Art 6.1) gives every member the right to inspect these records.
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(10, 2)
  type        String   // "ADVANCE", "REGISTRATION", "MEMBERSHIP", "OTHER"
  description String?
  date        DateTime @default(now())
}

/// NOTE: Transaction is retained read-only as the migration reference. All new
/// financial code writes LedgerEntry instead. It is dropped once the ledger has
/// been reconciled against it in production.

/// What a ledger entry is for.
///
/// This enum is the classification surface for the association's own reporting
/// and for IRS Form 990, so values are added rather than renamed.
enum LedgerAccount {
  /// Balances carried over from the treasurer's spreadsheet at migration.
  OPENING_BALANCE
  /// Art 5.3 — kiingilio, $100, non-refundable.
  ENTRY_FEE
  /// Art 5.3 / 17.1 — ada, $25, every April, non-refundable.
  ANNUAL_DUES
  /// Art 5.3 — akiba tangulizi, $100, refundable. The float levies draw from.
  ADVANCE_DEPOSIT
  /// Art 17.2 — shida/msiba, $3,000 divided among active members.
  HARDSHIP_LEVY
  /// Art 17.3 — death of a member or their child under 21, $10,000 divided.
  DEATH_LEVY
  /// Art 6.2 — 10% of what TSA had to borrow because an advance was short.
  BORROW_PENALTY
  /// Art 5.4 — money received minus money contributed, repaid on exit.
  EXIT_REPAYMENT
  /// Art 18.1 / 18.2 — mafao paid to a member.
  BENEFIT_PAYOUT
  /// Art 4.3 — $300 toward a memorial, managed by a leader.
  MEMORIAL_GRANT
  /// Art 18.6 / 18.7 / 18.8 — birthdays, weddings, graduations.
  MILESTONE_GRANT
  DONATION
  /// Art 18.3 — 10% to whoever brought in an outside donation.
  FINDER_INCENTIVE
  /// Art 18.4 — $200 per event paid out, leadership motisha.
  LEADERSHIP_MOTISHA
  /// Art 18.5 — mileage, food, lodging for leaders on association business.
  REIMBURSEMENT
  /// Payment processing costs. Kept separate, never netted off an amount.
  PROCESSING_FEE
  ADJUSTMENT
}

enum LedgerEntryKind {
  OPENING
  /// An obligation placed on a member.
  CHARGE
  /// Money in.
  PAYMENT
  /// Money out.
  PAYOUT
  /// Undoes an earlier entry. Corrections are never edits.
  REVERSAL
  ADJUSTMENT
}

/// The association's books.
///
/// Append-only. Entries are never updated or deleted — a mistake is corrected
/// by posting a REVERSAL that points at the original. KATIBA Art 6.1 gives
/// every member the right to inspect these records, which is only meaningful if
/// they cannot be quietly rewritten.
///
/// Amounts are **signed integer cents**. Positive increases what the member
/// holds; negative is a charge or a payout. Never a float, and never Decimal:
/// Art 17.2 divides $3,000 among 154 members, which needs exact remainder
/// handling that only integers give.
model LedgerEntry {
  id          String          @id @default(uuid())

  /// Null for association-side entries that belong to no member — the Art 18.4
  /// leadership motisha, or borrowing from the Investment Club.
  memberId    String?
  member      Member?         @relation(fields: [memberId], references: [id], onDelete: Restrict)

  account     LedgerAccount
  entryKind   LedgerEntryKind
  amountCents Int
  currency    String          @default("USD")

  description   String
  descriptionSw String?

  /// When it happened in the association's affairs — an April dues run, the
  /// date a case was announced. Distinct from when the row was written.
  occurredAt DateTime
  postedAt   DateTime @default(now())

  /// Links out to whatever caused this entry. Nullable now; used from Stage 2.
  caseEventId  String?
  assessmentId String?
  paymentId    String?

  /// The entry this reverses, if any.
  reversesId String?      @unique
  reverses   LedgerEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy LedgerEntry? @relation("Reversal")
  /// Set only once a reversal exists, so voided entries drop out of balances.
  voidedAt   DateTime?

  createdByUserId String?

  /// Makes double-posting impossible even across separate code paths, e.g.
  /// "stripe:pi_123:ADVANCE_DEPOSIT" or "legacy:<transaction id>".
  idempotencyKey String? @unique

  @@index([memberId, occurredAt])
  @@index([account, occurredAt])
  @@index([caseEventId])
  @@index([assessmentId])
}

/// A cached view of each member's position.
///
/// Derived, never authoritative: it is recomputed inside the same transaction
/// as every ledger write, and a nightly job rebuilds it from raw entries and
/// alerts on drift. It exists because the admin directory otherwise loads every
/// transaction for all 154 members on each page view — which is fine at 300
/// rows and not at the thousands a year the levies will produce.
model MemberBalance {
  memberId            String   @id
  member              Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  netCents            Int      @default(0)
  advanceCents        Int      @default(0)
  entryFeeCents       Int      @default(0)
  duesCents           Int      @default(0)
  /// Which April cycle duesCents refers to.
  duesYear            Int
  /// Levies charged but not yet covered.
  outstandingCents    Int      @default(0)

  recomputedAt DateTime @default(now())
}

/// A form submitted from the public site or the portal.
///
/// Written to the database first, then emailed. Previously the four public
/// forms only sent email, so every application anyone had ever submitted
/// existed solely in a mailbox and the admin review queue was permanently
/// empty.
model FormSubmission {
  id         String   @id @default(uuid())
  /// Short human-quotable code, e.g. "TSA-F-4K2P9". A member who phones the
  /// secretary can read this out.
  reference  String   @unique
  memberId   String?  // Null until linked to a member
  member     Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  formType   String   // "MEMBERSHIP", "CONSTITUTION", "FUNERAL_ASSISTANCE", "RENEWAL"
  status     Status   @default(PENDING)
  data       Json     // Full validated payload, including fields no column holds

  // Promoted out of `data` for the queue UI, search and duplicate detection.
  submitterName  String?
  submitterEmail String?
  submitterPhone String?  // E.164 where it could be normalised
  locale         String   @default("sw")

  // Notification outcome. A failed email must not lose the submission.
  emailSentAt DateTime?
  emailError  String?

  // Review trail
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  source     String   @default("web") // "web" | "portal" | "manual"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([formType, status])
  @@index([submitterPhone])
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  DECEASED
}

enum DelegationStatus {
  PENDING_OWNER_APPROVAL
  ACTIVE
  REVOKED
  EXPIRED
}

enum DelegationOrigin {
  /// The member set it up themselves and approved with a code to their phone.
  SELF_SERVICE
  /// An officer set it up for a member who does not use the portal.
  ADMIN_PROVISIONED
}

enum DelegationPermission {
  VIEW_FINANCES
  MAKE_PAYMENTS
  SUBMIT_FORMS
  EDIT_PROFILE
}

/// Permission for one person to act on another member's behalf.
///
/// Some members already manage relatives' TSA affairs — an older member's
/// daughter, a spouse. This makes that sanctioned and auditable instead of
/// happening by sharing a login.
model Delegation {
  id            String   @id @default(uuid())

  /// Whose account is being accessed.
  ownerMemberId String
  ownerMember   Member   @relation("DelegationOwner", fields: [ownerMemberId], references: [id], onDelete: Cascade)

  /// Who may access it. Null until they first sign in and accept.
  delegateUserId String?
  delegateUser   User?   @relation("DelegationDelegate", fields: [delegateUserId], references: [id], onDelete: Cascade)
  /// The invitation is always addressed to a phone number.
  delegatePhoneE164 String
  delegateName      String
  relationship      String?  // "daughter", "spouse", "neighbour"

  permissions DelegationPermission[]
  status      DelegationStatus @default(PENDING_OWNER_APPROVAL)
  origin      DelegationOrigin

  // Consent trail. An admin-provisioned grant must say how consent was given.
  createdByUserId    String?
  authorizedByUserId String?
  authorizationNote  String?
  ownerConsentAt     DateTime?
  ownerConsentMethod String?   // "PHONE_CODE" | "IN_PERSON" | "WRITTEN"

  expiresAt DateTime?
  revokedAt DateTime?
  revokedByUserId String?
  revokedReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actingSessions ActingSession[]

  @@unique([ownerMemberId, delegatePhoneE164])
  @@index([ownerMemberId, status])
  @@index([delegateUserId, status])
  @@index([delegatePhoneE164, status])
}

/// An open period during which someone is acting on another member's behalf.
///
/// The JWT carries only this row's id. Everything that matters is re-read from
/// here on each request, so revoking a delegation takes effect on the delegate's
/// very next request rather than whenever their token happens to expire.
model ActingSession {
  id           String   @id @default(uuid())
  delegationId String
  delegation   Delegation @relation(fields: [delegationId], references: [id], onDelete: Cascade)

  actorUserId   String
  actorUser     User   @relation("ActingActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  ownerMemberId String

  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  endedReason String?   // USER_EXIT | REVOKED | EXPIRED | LOGOUT

  @@index([actorUserId, endedAt])
  @@index([ownerMemberId, endedAt])
}

enum Status {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
}

/// Append-only record of who did what.
///
/// KATIBA Art 6.1 gives every member the right to inspect the association's
/// records, so these entries must outlive the rows they describe. Actor and
/// target are stored as plain ids with a denormalised label rather than as
/// foreign keys, so no cascade or deletion can ever remove the evidence.
///
/// Never update or delete rows in this table.
model AuditLog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())

  // Who actually acted.
  actorUserId  String?
  actorLabel   String   // snapshot, e.g. "amina@example.com (ADMIN)"
  actorRole    String?

  // On whose behalf, when acting under a delegation.
  onBehalfOfMemberId String?

  action       String   // MEMBER_ARCHIVED, TRANSACTION_POSTED, ...
  entityType   String
  entityId     String
  summary      String
  metadata     Json?    // before/after diff, or a full snapshot for archives
  ipHash       String?
  success      Boolean  @default(true)
  failureReason String?

  @@index([entityType, entityId])
  @@index([onBehalfOfMemberId, createdAt])
  @@index([createdAt])
}
